-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg>Quarantine Rejects\n        </a>\n        <a href=\"/app/stock-entry?stock_entry_type=Material+Transfer\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><polyline points=\"20 6 9 17 4 12\"/></svg>Removed From Quarantine\n        </a>\n        <a href=\"/app/stock-entry?stock_entry_type=Field+Rejects\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"/><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"/></svg>Field Rejects\n        </a>\n      </div>\n    </div>\n\n    <!-- Quality Configurations -->\n    <div class=\"qcnav-card\">\n      <div class=\"qcnav-card-header qcnav-gray\">\n        <div class=\"qcnav-card-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"18\" height=\"18\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14\"/></svg>\n        </div>\n        <span>Quality Configurations</span>\n      </div>\n      <div class=\"qcnav-links\">\n        <a href=\"/app/production-settings\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14\"/></svg>Production Settings\n        </a>\n        <a href=\"/app/qc-parameters\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>Quality Parameters\n        </a>\n      </div>\n    </div>\n\n\n    <!-- Solution Mixing -->\n    <div class=\"qcnav-card\">\n      <div class=\"qcnav-card-header qcnav-gray\">\n        <div class=\"qcnav-card-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"18\" height=\"18\"><path d=\"M12 2v6m-6 4h12M5 12a7 7 0 1 0 14 0c0-3.86-5-9-7-9s-7 5.14-7 9z\"/></svg>\n        </div>\n        <span>Solution Mixing</span>\n      </div>\n      <div class=\"qcnav-links\">\n        <a href=\"/solution-mixing-overview\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg>Mixing Dashboard\n        </a>\n        <a href=\"/app/solution-mix\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>Solution Mix Entries\n        </a>\n        <a href=\"/app/post-harvest-mixing-tank\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/></svg>Mixing Tanks\n        </a>\n        <a href=\"/app/post-harvest-chemicals\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><path d=\"M9 3h6M10 3v6l-5 9a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3\"/></svg>Post Harvest Chemicals\n        </a>\n      </div>\n    </div>\n\n\n    <!-- Coldroom Operations -->\n    <div class=\"qcnav-card\">\n      <div class=\"qcnav-card-header qcnav-gray\">\n        <div class=\"qcnav-card-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"18\" height=\"18\"><path d=\"M22 14.76V12a10 10 0 0 0-20 0v2.76M2 14.76l3-3 3 3M16 14.76l3-3 3 3\"/></svg>\n        </div>\n        <span>Coldroom Operations</span>\n      </div>\n      <div class=\"qcnav-links\">\n        <a href=\"/coldroom-overview\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg>Coldroom Dashboard\n        </a>\n        <a href=\"/app/cold-store-temperature-log\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><path d=\"M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z\"/></svg>Temperature Logs\n        </a>\n        <a href=\"/app/coldroom-cleaning-record\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M16 8l-8 8M8 8l8 8\"/></svg>Cleaning Records\n        </a>\n        <a href=\"/app/coldroom-inspection-log\" class=\"qcnav-link\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" width=\"14\" height=\"14\"><polyline points=\"9 11 12 14 22 4\"/><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/></svg>Inspection Logs\n        </a>\n      </div>\n    </div>\n\n  </div>\n</div>",
