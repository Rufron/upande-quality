  "html": "<div class=\"scpn\">\n  <div class=\"scpn-title\">Upande Quality</div>\n  <div class=\"scpn-sec\">Dashboards</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/intake-ftr-overview\"><span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Quality Dashboard</span><span class=\"scpn-sub\">Intake FTR overview</span></span></a>\n    <a class=\"scpn-tile\" href=\"/packhouse-overview\"><span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Packhouse</span><span class=\"scpn-sub\">Packhouse QC overview</span></span></a>\n    <a class=\"scpn-tile\" href=\"/coldroom-overview\"><span class=\"scpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 14.76V12a10 10 0 0 0-20 0v2.76M2 14.76l3-3 3 3M16 14.76l3-3 3 3\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Coldroom Ops</span><span class=\"scpn-sub\">Cold chain monitoring</span></span></a>\n    <a class=\"scpn-tile\" href=\"/solution-mixing-overview\"><span class=\"scpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2v6m-6 4h12M5 12a7 7 0 1 0 14 0c0-3.86-5-9-7-9s-7 5.14-7 9z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Solution Mixing</span><span class=\"scpn-sub\">Post-harvest solutions</span></span></a>\n    <a class=\"scpn-tile\" href=\"/rejects\"><span class=\"scpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Rejects</span><span class=\"scpn-sub\">Rejects &amp; downgrades</span></span></a>\n    <a class=\"scpn-tile\" href=\"/quality-trends\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Quality Trends</span><span class=\"scpn-sub\">Trends &amp; analytics</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Records &amp; Reports</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/quality-reporting\"><span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><rect x=\"8\" y=\"2\" width=\"8\" height=\"4\" rx=\"1\"/><path d=\"M9 12l2 2 4-4\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Quality Reporting</span><span class=\"scpn-sub\">Intake QC records</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/quality-reporting?control_point=Packhouse\"><span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Packhouse QC</span><span class=\"scpn-sub\">Packhouse QC records</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/corrective-action-report\"><span class=\"scpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><path d=\"M9 15l2 2 4-4\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Corrective Actions</span><span class=\"scpn-sub\">CAR register</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/corrective-action-resolution\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"9 11 12 14 22 4\"/><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">CA Resolutions</span><span class=\"scpn-sub\">Resolution tracking</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/query-report/Quality Assessment\"><span class=\"scpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"10\"/><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"16\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Quality Assessment</span><span class=\"scpn-sub\">Assessment report</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/query-report/Field Rejects Report\"><span class=\"scpn-ic\" style=\"background:rgba(239,68,68,.13);color:#dc2626\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Field Rejects Report</span><span class=\"scpn-sub\">Field rejects report</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Stock Entries</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/stock-entry?stock_entry_type=Receiving+Quarantined\"><span class=\"scpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><polyline points=\"19 12 12 19 5 12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Receiving Quarantined</span><span class=\"scpn-sub\">Receive to quarantine</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/stock-entry?stock_entry_type=Quarantine+Rejects\"><span class=\"scpn-ic\" style=\"background:rgba(239,68,68,.13);color:#dc2626\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"4.93\" y1=\"4.93\" x2=\"19.07\" y2=\"19.07\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Quarantine Rejects</span><span class=\"scpn-sub\">Reject from quarantine</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/stock-entry?stock_entry_type=Material+Transfer\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"16 3 21 3 21 8\"/><line x1=\"4\" y1=\"20\" x2=\"21\" y2=\"3\"/><polyline points=\"21 16 21 21 16 21\"/><line x1=\"15\" y1=\"15\" x2=\"21\" y2=\"21\"/><line x1=\"4\" y1=\"4\" x2=\"9\" y2=\"9\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Removed From Quarantine</span><span class=\"scpn-sub\">Release stock</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/stock-entry?stock_entry_type=Field+Rejects\"><span class=\"scpn-ic\" style=\"background:rgba(245,158,11,.13);color:#d97706\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Field Rejects</span><span class=\"scpn-sub\">Field rejects</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Post-Harvest &amp; Coldroom</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/solution-mix\"><span class=\"scpn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Solution Mix</span><span class=\"scpn-sub\">Mix entries</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/post-harvest-mixing-tank\"><span class=\"scpn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4.5 3h15M6 3v6.5L3 20a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1L18 9.5V3\"/><line x1=\"6\" y1=\"14\" x2=\"18\" y2=\"14\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Mixing Tanks</span><span class=\"scpn-sub\">Tank management</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/post-harvest-chemicals\"><span class=\"scpn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Post Harvest Chemicals</span><span class=\"scpn-sub\">Chemical register</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/cold-store-temperature-log\"><span class=\"scpn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Temperature Logs</span><span class=\"scpn-sub\">Cold store temps</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/coldroom-cleaning-record\"><span class=\"scpn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M19 4l-7 7M13 7l4 4M8 12l4 4-3.5 3.5a2.12 2.12 0 0 1-3-3L8 12z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Cleaning Records</span><span class=\"scpn-sub\">Coldroom cleaning</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/coldroom-inspection-log\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Inspection Logs</span><span class=\"scpn-sub\">Coldroom inspections</span></span></a>\n  </div>\n  <div class=\"scpn-sec\">Configuration</div>\n  <div class=\"scpn-grid\">\n    <a class=\"scpn-tile\" href=\"/app/production-settings\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Production Settings</span><span class=\"scpn-sub\">QC thresholds &amp; config</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/qc-parameters\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">QC Parameters</span><span class=\"scpn-sub\">Quality parameters</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/qc-control-point\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">QC Control Points</span><span class=\"scpn-sub\">Intake / Packhouse</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/packhouse-condition\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Packhouse Conditions</span><span class=\"scpn-sub\">Condition masters</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/packhouse-component\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 2 7 12 12 22 7 12 2\"/><polyline points=\"2 17 12 22 22 17\"/><polyline points=\"2 12 12 17 22 12\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Packhouse Components</span><span class=\"scpn-sub\">Component masters</span></span></a>\n    <a class=\"scpn-tile\" href=\"/app/packhouse-rejection-reason\"><span class=\"scpn-ic\" style=\"background:rgba(100,116,139,.13);color:#64748b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"4.93\" y1=\"4.93\" x2=\"19.07\" y2=\"19.07\"/></svg></span><span class=\"scpn-tx\"><span class=\"scpn-lb\">Rejection Reasons</span><span class=\"scpn-sub\">Reject reason masters</span></span></a>\n  </div>\n</div>",
