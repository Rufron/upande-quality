  "script": "/* QC Navigation — no JS needed */",
  "style": "/* Base */\n.qcnav {\n  font-family: var(--font-stack);\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n/* Banner */\n.qcnav-banner {\n  border-radius: 10px;\n  overflow: hidden;\n}\n.qcnav-banner-link {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 14px 20px;\n  background: linear-gradient(135deg, #6d28d9, #8b5cf6);\n  color: white;\n  text-decoration: none;\n  transition: opacity 0.15s;\n}\n.qcnav-banner-link:hover {\n  opacity: 0.93;\n  text-decoration: none;\n}\n.qcnav-banner-icon {\n  width: 40px;\n  height: 40px;\n  border-radius: 8px;\n  background: rgba(255,255,255,0.15);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.qcnav-banner-text {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.qcnav-banner-title {\n  font-size: 0.9375rem;\n  font-weight: 700;\n  color: white;\n}\n.qcnav-banner-sub {\n  font-size: 0.75rem;\n  opacity: 0.85;\n  color: white;\n}\n.qcnav-banner-arrow {\n  margin-left: auto;\n  font-size: 1.25rem;\n  color: white;\n}\n\n/* Dashboard shortcut buttons */\n.qcnav-shortcuts {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.qcnav-shortcut {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 9px 16px;\n  border-radius: 8px;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  text-decoration: none;\n  transition: opacity 0.15s, transform 0.1s;\n  border: none;\n  cursor: pointer;\n}\n.qcnav-shortcut:hover {\n  opacity: 0.88;\n  transform: translateY(-1px);\n  text-decoration: none;\n}\n.qcnav-shortcut-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 22px;\n  height: 22px;\n  border-radius: 5px;\n  background: rgba(255,255,255,0.25);\n  flex-shrink: 0;\n}\n.qcnav-sc-amber {\n  background: #7c3aed;\n  color: white;\n}\n.qcnav-sc-orange {\n  background: #a78bfa;\n  color: white;\n}\n\n/* Grid */\n.qcnav-row {\n  display: grid;\n  gap: 16px;\n}\n.qcnav-row-3 {\n  grid-template-columns: repeat(3, 1fr);\n}\n\n/* Cards */\n.qcnav-card {\n  background: var(--fg-color);\n  border: 1px solid var(--border-color);\n  border-radius: 12px;\n  overflow: hidden;\n}\n.qcnav-card-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 14px 16px 12px;\n  border-bottom: 1px solid var(--border-color);\n}\n.qcnav-card-icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.qcnav-card-header span {\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n/* Purple theme variants */\n.qcnav-amber .qcnav-card-icon {\n  background: rgba(124,58,237,0.12);\n  color: #7c3aed;\n}\n.qcnav-orange .qcnav-card-icon {\n  background: rgba(139,92,246,0.12);\n  color: #8b5cf6;\n}\n.qcnav-gray .qcnav-card-icon {\n  background: rgba(139,92,246,0.10);\n  color: #6d28d9;\n}\n\n/* Links */\n.qcnav-links {\n  display: flex;\n  flex-direction: column;\n  padding: 6px;\n}\n.qcnav-link {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border-radius: 7px;\n  text-decoration: none;\n  font-size: 0.8125rem;\n  font-weight: 500;\n  color: var(--text-muted);\n  transition: background 0.15s, color 0.15s;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.qcnav-link:hover {\n  background: var(--control-bg, #f3f0ff);\n  color: var(--text-color);\n  text-decoration: none;\n}\n.qcnav-link svg {\n  flex-shrink: 0;\n  opacity: 0.6;\n}\n.qcnav-link:hover svg {\n  opacity: 1;\n}\n.qcnav-link-primary {\n  color: #7c3aed;\n  font-weight: 600;\n}\n.qcnav-link-primary svg {\n  color: #7c3aed;\n  opacity: 1;\n}\n.qcnav-link-primary:hover {\n  background: rgba(124,58,237,0.08);\n  color: #7c3aed;\n}\n\n/* Responsive */\n@media (max-width: 900px) {\n  .qcnav-row-3 {\n    grid-template-columns: 1fr;\n  }\n  .qcnav-shortcuts {\n    flex-direction: column;\n  }\n}"
 }
]