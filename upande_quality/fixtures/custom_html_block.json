  "script": "(function() {\n  // Poppins — document-level so it reaches this block's shadow root.\n  try {\n    if (!document.querySelector('link[data-scp-poppins]')) {\n      var pf=document.createElement('link'); pf.rel='stylesheet'; pf.setAttribute('data-scp-poppins','1');\n      pf.href='https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap';\n      document.head.appendChild(pf);\n    }\n  } catch(e){}\n})();",
  "style": ".scpn{padding:4px 2px;font-family:'Poppins',var(--font-stack),'Inter',sans-serif;}\n.scpn-title{font-size:15px;font-weight:700;color:var(--heading-color,#1f272e);margin:0 0 14px 2px;}\n.scpn-sec{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#8a8f98;font-weight:600;margin:20px 0 10px 2px;}\n.scpn-sec:first-of-type{margin-top:4px;}\n.scpn-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;}\n.scpn-tile{display:flex;align-items:center;gap:11px;padding:13px 15px;border:1px solid var(--border-color,#e2e4e9);border-radius:10px;background:var(--card-bg,#fff);text-decoration:none;color:inherit;transition:box-shadow .18s ease,transform .18s ease;}\n.scpn-tile:hover{box-shadow:0 2px 6px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none;}\n.scpn-tile:hover .scpn-lb,.scpn-tile:hover .scpn-sub{text-decoration:none;}\n.scpn-ic{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;color:inherit;}\n.scpn-ic svg{width:18px;height:18px;}\n.scpn-tx{min-width:0;display:flex;flex-direction:column;}\n.scpn-lb{display:block;font-size:13.5px;font-weight:600;line-height:1.2;}\n.scpn-sub{display:block;font-size:11px;color:#8a8f98;line-height:1.3;margin-top:2px;}\n.scpn-hide{display:none !important;}"
 }
]